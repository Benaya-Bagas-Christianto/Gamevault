                            <div style="width:36px;height:36px;border-radius:50%;background:var(--c-surface-soft);display:flex;align-items:center;justify-content:center;color:var(--c-on-dark);font-weight:700;font-size:0.9rem;border:1px solid var(--c-hairline-strong);">
                                {{ strtoupper(substr($review->user->name ?? 'A', 0, 1)) }}
                            </div>
                            <div>
                                <div style="font-weight:600;color:var(--c-on-dark);font-size:0.9rem;">{{ $review->user->name ?? 'Pengguna' }}</div>
                                <div style="font-size:0.75rem;color:var(--c-mute);">{{ $review->created_at->diffForHumans() }}</div>
                            </div>
                        </div>
                        <div style="display:flex;gap:2px;">
                            @for($s=1;$s<=5;$s++)
                                <i class="{{ $s <= $review->rating ? 'fas' : 'far' }} fa-star" style="color:#f59e0b;font-size:0.85rem;"></i>
                            @endfor
                        </div>
                    </div>
                    <p style="color:var(--c-body);margin:0;line-height:1.7;font-size:0.9rem;">{{ $review->review }}</p>
                </div>
                @endforeach
            </div>
        @else
            <div style="text-align:center;padding:40px 20px;color:#888;">
                <i class="far fa-comment" style="font-size:2.5rem;display:block;margin-bottom:12px;"></i>
                Belum ada ulasan untuk game ini.
                @if($canReview && !$userReview) Jadilah yang pertama! @endif
            </div>
        @endif
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content || '';

    // Star Rating UI
    const starContainer = document.getElementById('star-rating');
    if (starContainer) {
        const labels = starContainer.querySelectorAll('label');
        labels.forEach((label, idx) => {
            const icon = label.querySelector('i');
            const radio = label.querySelector('input');
            label.addEventListener('mouseenter', () => {
                labels.forEach((l, i) => l.querySelector('i').className = i <= idx ? 'fas fa-star' : 'far fa-star');
                labels.forEach((l, i) => l.querySelector('i').style.color = i <= idx ? '#f59e0b' : '#ddd');
            });
            label.addEventListener('mouseleave', () => {
                const checked = starContainer.querySelector('input:checked');
                const val = checked ? parseInt(checked.value) : 0;
                labels.forEach((l, i) => {
                    l.querySelector('i').className = i < val ? 'fas fa-star' : 'far fa-star';
                    l.querySelector('i').style.color = i < val ? '#f59e0b' : '#ddd';
                });
            });
            radio.addEventListener('change', () => {
                labels.forEach((l, i) => {
                    l.querySelector('i').className = i <= idx ? 'fas fa-star' : 'far fa-star';
                    l.querySelector('i').style.color = i <= idx ? '#f59e0b' : '#ddd';
                });
            });
        });
    }

    // Add to Cart
    const cartBtn = document.getElementById('add-to-cart-btn');
    if (cartBtn) {
        cartBtn.addEventListener('click', function() {
            const slug = this.dataset.gameSlug;
            const isActive = this.classList.contains('btn-outline');
            fetch(isActive ? `/cart/${slug}` : `/cart/${slug}`, {
                method: isActive ? 'DELETE' : 'POST',
                headers: {'Content-Type':'application/json','X-CSRF-TOKEN':csrfToken,'Accept':'application/json'},
                body: JSON.stringify({_token: csrfToken})
            }).then(r=>r.json()).then(data => {
                if (data.error) { if (typeof showCenterPopup==='function') showCenterPopup(data.error, false); return; }
                this.classList.toggle('btn-primary', data.in_cart);
                this.classList.toggle('btn-outline', !data.in_cart);
                const now = !data.in_cart; // btn-outline means not in cart (wait, outline = not in cart? No, currently outline means it IS in cart, wait)
                
                // Let's use data.in_cart directly
                if (data.in_cart) {
                    this.classList.remove('btn-primary');
                    this.classList.add('btn-outline');
                    this.innerHTML = `<i class="fas fa-check"></i> Ada di Keranjang`;
                } else {
                    this.classList.remove('btn-outline');
                    this.classList.add('btn-primary');
                    this.innerHTML = `<i class="fas fa-shopping-cart"></i> Tambah ke Keranjang`;
                }
                
                if (typeof showCenterPopup==='function') showCenterPopup(data.message, true);
                if (typeof updateBadge==='function') updateBadge('cart-count', data.count);
            }).catch(()=>{});
        });
    }

    // Add to Cart for DLCs
    const dlcCartBtns = document.querySelectorAll('.add-to-cart-dlc');
    dlcCartBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            const slug = this.dataset.gameSlug;
            fetch(`/cart/${slug}`, {
                method: 'POST',
                headers: {'Content-Type':'application/json','X-CSRF-TOKEN':csrfToken,'Accept':'application/json'},
                body: JSON.stringify({_token: csrfToken})
            }).then(r=>r.json()).then(data => {
                if (data.error) { if (typeof showCenterPopup==='function') showCenterPopup(data.error, false); return; }
                if (data.in_cart) {
                    this.innerHTML = `<i class="fas fa-check"></i>`;
                } else {
                    this.innerHTML = `<i class="fas fa-cart-plus"></i>`;
                }
                if (typeof showCenterPopup==='function') showCenterPopup(data.message, true);
                if (typeof updateBadge==='function') updateBadge('cart-count', data.count);
            }).catch(()=>{});
        });
    });

    // Add to Wishlist
    const wishBtn = document.getElementById('add-to-wishlist-btn');
    if (wishBtn) {
        wishBtn.addEventListener('click', function() {
            const slug = this.dataset.gameSlug;
            const icon = this.querySelector('i');
            const isActive = icon.classList.contains('fas');
            fetch(isActive ? `/wishlist/${slug}` : `/wishlist/${slug}`, {
                method: 'POST', // Wishlist toggle is always POST in WishlistController
                headers: {'Content-Type':'application/json','X-CSRF-TOKEN':csrfToken,'Accept':'application/json'},
                body: JSON.stringify({_token: csrfToken})
            }).then(r=>r.json()).then(data => {
                if (data.error) { if (typeof showCenterPopup==='function') showCenterPopup(data.error, false); return; }
                
                if (data.in_wishlist) {
                    icon.className = 'fas fa-heart';
                    this.style.borderColor = 'var(--c-primary)';
                    this.style.background = 'var(--c-primary)';
                    this.style.color = '#000';
                } else {
                    icon.className = 'far fa-heart';
                    this.style.borderColor = 'var(--c-hairline)';
                    this.style.background = 'transparent';
                    this.style.color = 'var(--c-body)';
                }
                
                if (typeof showCenterPopup==='function') showCenterPopup(data.message, true);
                if (typeof updateBadge==='function') updateBadge('wishlist-count', data.count);
            }).catch(()=>{});
        });
    }
});
</script>

@endsection
